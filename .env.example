# Скопируйте в .env и заполните. Сам .env не коммитится (.gitignore).

# Пароль PostgreSQL (сервис db). Из него же собирается DATABASE_URL для web и bot.
# Только буквы и цифры, иначе сломается строка подключения. Сгенерировать: openssl rand -hex 24
# На уже созданной базе смена этого значения пароль НЕ меняет: сначала ALTER USER в контейнере db.
POSTGRES_PASSWORD=

TELEGRAM_TOKEN=
TELEGRAM_PROXY=
CHECKO_API_KEY=
LLM_API_KEY=
GIGACHAT_API_TOKEN=
SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMS_API_KEY=
